# Provider (any OpenAI-compatible endpoint)
ARGO_BASE_URL=https://api.openai.com/v1
ARGO_MODEL=gpt-4o-mini
ARGO_API_KEY=sk-replace-me

# Optional: embeddings + rerank enable hybrid retrieval
# ARGO_EMBEDDING_MODEL=text-embedding-3-small

# Optional: reliable web search (keyless engines are rate-limited on cloud IPs)
# TAVILY_API_KEY=tvly-...
# BRAVE_API_KEY=...
# ARGO_SEARCH_PROVIDER=tavily

# Optional: separate state directory
# ARGO_HOME=~/.argo
